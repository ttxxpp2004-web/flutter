 void divideNumbers(double? num1, double? num2) {
  try {
    if (num1 == null || num2 == null) {
      print("أحد المدخلات فارغ.");
      return;
    }

    if (num2 == 0) {
      throw Exception("لا يمكن القسمة على صفر.");
    }

    double result = num1 / num2;
    print("الناتج = $result");
  } catch (e) {
    print("حدث خطأ: $e");
  }
}

void main() {
  divideNumbers(20, 5);
  divideNumbers(20, 0);
  divideNumbers(null, 5);
}